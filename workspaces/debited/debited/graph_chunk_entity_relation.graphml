  <data key="d0">FATCA Application</data>
  <data key="d1">data</data>
  <data key="d2">FATCA Application refers to the forms and documentation required to comply with the Foreign Account Tax Compliance Act.</data>
  <data key="d3">doc-2e34273750791ef213944c7971a5e5a1-chunk-011</data>
  <data key="d4">SOP - Account opening for Retail Customers.pdf</data>
  <data key="d5">1786619091</data>
  <data key="d6"></data>
</node>
<node id="CPC Team">
  <data key="d0">CPC Team</data>
  <data key="d1">organization</data>
  <data key="d2">The CPC Team is the department responsible for processing account changes and ensuring the correct implementation of banking procedures.</data>
