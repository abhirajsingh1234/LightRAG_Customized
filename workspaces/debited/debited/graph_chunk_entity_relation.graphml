<graph edgedefault="undirected"><node id="Reserve Bank of India">
  <data key="d0">Reserve Bank of India</data>
  <data key="d1">organization</data>
  <data key="d2">The central bank of India, responsible for regulating the nation's currency and financial system, which has issued guidelines for Doorstep Banking services.</data>
  <data key="d3">doc-574eef8b2a231a2171cb4eadad4c29e5-chunk-000</data>
