<node id="Compliance Officer">
  <data key="d0">Compliance Officer</data>
  <data key="d1">person</data>
  <data key="d2">A designated officer responsible for ensuring that the bank complies with legal and regulatory requirements, particularly regarding PEPs.</data>
  <data key="d3">doc-2e34273750791ef213944c7971a5e5a1-chunk-005</data>
