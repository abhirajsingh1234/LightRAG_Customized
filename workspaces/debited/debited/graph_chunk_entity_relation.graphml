  <data key="d0">Savings Accounts</data>
  <data key="d1">concept</data>
  <data key="d2">Savings Accounts are a type of bank account that allows customers to save money while earning interest on their deposits.</data>
  <data key="d3">doc-2e34273750791ef213944c7971a5e5a1-chunk-011</data>
  <data key="d4">SOP - Account opening for Retail Customers.pdf</data>
  <data key="d5">1786619091</data>
  <data key="d6"></data>
</node>
<node id="Fixed Deposits">
  <data key="d0">Fixed Deposits</data>
  <data key="d1">concept</data>
  <data key="d2">Fixed Deposits are financial instruments provided by banks that offer higher interest rates for locking in funds for a specified term.</data>
  <data key="d3">doc-2e34273750791ef213944c7971a5e5a1-chunk-011</data>
  <data key="d4">SOP - Account opening for Retail Customers.pdf</data>
  <data key="d5">1786619091</data>
  <data key="d6"></data>
</node>
<node id="Basic Savings Deposit Accounts">
  <data key="d0">Basic Savings Deposit Accounts</data>
  <data key="d1">concept</data>
  <data key="d2">Basic Savings Deposit Accounts are simple bank accounts aimed at promoting savings among individuals with minimal fees.</data>
  <data key="d3">doc-2e34273750791ef213944c7971a5e5a1-chunk-011</data>
  <data key="d4">SOP - Account opening for Retail Customers.pdf</data>
  <data key="d5">1786619091</data>
  <data key="d6"></data>
</node>
<node id="Special Fixed Deposit Schemes">
  <data key="d0">Special Fixed Deposit Schemes</data>
  <data key="d1">concept</data>
  <data key="d2">Special Fixed Deposit Schemes are unique financial products that offer attractive interest rates and conditions for specific customer categories.</data>
  <data key="d3">doc-2e34273750791ef213944c7971a5e5a1-chunk-011</data>
  <data key="d4">SOP - Account opening for Retail Customers.pdf</data>
  <data key="d5">1786619091</data>
  <data key="d6"></data>
</node>
