  <data key="d8">NRE Deposits are subject to interest rate offerings by Scheduled Commercial Banks, which shall not exceed rates on domestic rupee term deposits.</data>
  <data key="d9">interest rates,offering</data>
  <data key="d10">doc-6e9c97657e05cf315dfdf575fb8d6364-chunk-007</data>
  <data key="d11">Deposit Policy.pdf</data>
  <data key="d12">1786608393</data>
  <data key="d13"></data>
</edge>
<edge source="NRE Deposits" target="Deposit Insurance and Credit Guarantee Corporation of India (DICGC)">
  <data key="d7">1.0</data>
  <data key="d8">NRE Deposits are covered under the insurance scheme offered by the Deposit Insurance and Credit Guarantee Corporation of India (DICGC).</data>
  <data key="d9">insurance cover</data>
  <data key="d10">doc-6e9c97657e05cf315dfdf575fb8d6364-chunk-007</data>
  <data key="d11">Deposit Policy.pdf</data>
  <data key="d12">1786608393</data>
  <data key="d13"></data>
</edge>
<edge source="Overdue Term Deposit" target="Deposit">
  <data key="d7">1.0</data>
  <data key="d8">A term deposit can become an overdue term deposit if it matures and the proceeds remain unpaid.</data>
  <data key="d9">becomes,status</data>
  <data key="d10">doc-6e9c97657e05cf315dfdf575fb8d6364-chunk-006</data>
  <data key="d11">Deposit Policy.pdf</data>
  <data key="d12">1786608393</data>
  <data key="d13"></data>
</edge>
<edge source="NRO Deposits" target="Scheduled Commercial Banks">
  <data key="d7">1.0</data>
  <data key="d8">NRO Deposits are managed by Scheduled Commercial Banks that do not provide additional interest rates for certain depositor categories.</data>
  <data key="d9">interest rates,offering</data>
  <data key="d10">doc-6e9c97657e05cf315dfdf575fb8d6364-chunk-007</data>
  <data key="d11">Deposit Policy.pdf</data>
  <data key="d12">1786608393</data>
  <data key="d13"></data>
</edge>
<edge source="Scheduled Commercial Banks" target="Board of Directors">
  <data key="d7">1.0</data>
  <data key="d8">Scheduled Commercial Banks require the approval of the Board of Directors for comprehensive policies concerning penalties on premature withdrawals.</data>
  <data key="d9">deposits,policy approval</data>
  <data key="d10">doc-6e9c97657e05cf315dfdf575fb8d6364-chunk-007</data>
  <data key="d11">Deposit Policy.pdf</data>
  <data key="d12">1786608393</data>
  <data key="d13"></data>
</edge>
<edge source="Scheduled Commercial Banks" target="Customer Information">
  <data key="d7">1.0</data>
  <data key="d8">Customer Information collected by Scheduled Commercial Banks may be used for cross-selling services, contingent on obtaining necessary consent.</data>
  <data key="d9">consent,cross-selling</data>
  <data key="d10">doc-6e9c97657e05cf315dfdf575fb8d6364-chunk-007</data>
  <data key="d11">Deposit Policy.pdf</data>
  <data key="d12">1786608393</data>
  <data key="d13"></data>
</edge>
<edge source="Banking Ombudsman" target="Customer">
  <data key="d7">1.0</data>
  <data key="d8">Customers may approach the Banking Ombudsman for assistance if they have unresolved complaints regarding the Bank's services.</data>
  <data key="d9">approaches,complaints</data>
  <data key="d10">doc-6e9c97657e05cf315dfdf575fb8d6364-chunk-008</data>
  <data key="d11">Deposit Policy.pdf</data>
  <data key="d12">1786608393</data>
  <data key="d13"></data>
</edge>
<edge source="Customer" target="Net Banking">
  <data key="d7">1.0</data>
  <data key="d8">Customers use Net Banking to manage their accounts and conduct financial transactions online.</data>
