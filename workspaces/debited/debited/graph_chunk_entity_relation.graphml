  <data key="d4">SOP - Account opening for Retail Customers.pdf</data>
  <data key="d5">1786619091</data>
  <data key="d6"></data>
</node>
<node id="BSBDA Account">
  <data key="d0">BSBDA Account</data>
  <data key="d1">concept</data>
  <data key="d2">A BSBDA (Basic Savings Bank Deposit Account) is a type of savings account with basic features that is accessible to all.</data>
  <data key="d3">doc-2e34273750791ef213944c7971a5e5a1-chunk-012</data>
  <data key="d4">SOP - Account opening for Retail Customers.pdf</data>
  <data key="d5">1786619091</data>
  <data key="d6"></data>
</node>
