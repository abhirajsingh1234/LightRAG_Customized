</node>
<node id="Authorized Signatory">
  <data key="d0">Authorized Signatory</data>
  <data key="d1">person</data>
  <data key="d2">An individual authorized to operate an account, conduct transactions, and sign documents on behalf of the account holder.</data>
  <data key="d3">doc-2e34273750791ef213944c7971a5e5a1-chunk-013</data>
  <data key="d4">SOP - Account opening for Retail Customers.pdf</data>
