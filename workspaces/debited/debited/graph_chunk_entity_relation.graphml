  <data key="d5">1786619091</data>
  <data key="d6"></data>
</node>
<node id="Letter of Authority">
  <data key="d0">Letter of Authority</data>
  <data key="d1">content</data>
  <data key="d2">A legal document under which one person authorizes another to perform specific acts, used for tasks like document submission and inquiries.</data>
