</node>
<node id="Legal Guardian">
  <data key="d0">Legal Guardian</data>
  <data key="d1">person</data>
  <data key="d2">An individual legally appointed to manage the personal and financial affairs of a disabled person.</data>
  <data key="d3">doc-6e9c97657e05cf315dfdf575fb8d6364-chunk-004</data>
  <data key="d4">Deposit Policy.pdf</data>
  <data key="d5">1786700916</data>
  <data key="d6"></data>
</node>
<node id="District Courts">
  <data key="d0">District Courts</data>
  <data key="d1">organization</data>
  <data key="d2">Local judicial entities responsible for appointing guardians for individuals unable to manage their own affairs under the Mental Health Act.</data>
  <data key="d3">doc-6e9c97657e05cf315dfdf575fb8d6364-chunk-004</data>
  <data key="d4">Deposit Policy.pdf</data>
  <data key="d5">1786700916</data>
  <data key="d6"></data>
</node>
<node id="Local Level Committees">
  <data key="d0">Local Level Committees</data>
  <data key="d1">organization</data>
  <data key="d2">Committees set up under specific disability acts to oversee and facilitate the care and welfare of persons with disabilities.</data>
  <data key="d3">doc-6e9c97657e05cf315dfdf575fb8d6364-chunk-004</data>
  <data key="d4">Deposit Policy.pdf</data>
  <data key="d5">1786700916</data>
  <data key="d6"></data>
</node>
<node id="RBI">
  <data key="d0">RBI</data>
  <data key="d1">organization</data>
  <data key="d2">The Reserve Bank of India, which sets the guidelines for banking operations and regulations within India.&lt;SEP&gt;Reserve Bank of India, the central banking institution of India, which issues guidelines and regulations affecting banking practices.</data>
  <data key="d3">doc-6e9c97657e05cf315dfdf575fb8d6364-chunk-004&lt;SEP&gt;doc-6e9c97657e05cf315dfdf575fb8d6364-chunk-006</data>
