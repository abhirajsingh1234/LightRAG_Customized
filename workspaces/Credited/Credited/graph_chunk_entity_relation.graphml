  <data key="d0">Domestic Non-Resident Ordinary Account</data>
  <data key="d1">other</data>
  <data key="d2">A type of account that accepts deposits from non-resident individuals and pays interest on those deposits.</data>
  <data key="d3">doc-6e9c97657e05cf315dfdf575fb8d6364-chunk-005</data>
  <data key="d4">Deposit Policy.pdf</data>
  <data key="d5">1786700916</data>
  <data key="d6"></data>
</node>
<node id="Non-Resident External Account">
  <data key="d0">Non-Resident External Account</data>
  <data key="d1">other</data>
  <data key="d2">A type of account that allows non-residents to hold deposits in foreign currency and earn interest.</data>
  <data key="d3">doc-6e9c97657e05cf315dfdf575fb8d6364-chunk-005</data>
  <data key="d4">Deposit Policy.pdf</data>
  <data key="d5">1786700916</data>
  <data key="d6"></data>
</node>
<node id="Rupees">
  <data key="d0">Rupees</data>
  <data key="d1">data</data>
  <data key="d2">The currency used in India for financial transactions, including interest calculations.</data>
  <data key="d3">doc-6e9c97657e05cf315dfdf575fb8d6364-chunk-005</data>
  <data key="d4">Deposit Policy.pdf</data>
  <data key="d5">1786700916</data>
  <data key="d6"></data>
</node>
<node id="Domestic Current Account">
  <data key="d0">Domestic Current Account</data>
  <data key="d1">other</data>
  <data key="d2">An account type in which no interest is paid on deposits, but balances of deceased individuals attract interest from the date of death.</data>
  <data key="d3">doc-6e9c97657e05cf315dfdf575fb8d6364-chunk-005</data>
  <data key="d4">Deposit Policy.pdf</data>
  <data key="d5">1786700916</data>
  <data key="d6"></data>
</node>
<node id="Domestic Savings Bank Accounts">
  <data key="d0">Domestic Savings Bank Accounts</data>
  <data key="d1">other</data>
  <data key="d2">Accounts that earn interest calculated daily and credited at specified intervals, with differential rates for large balances.</data>
  <data key="d3">doc-6e9c97657e05cf315dfdf575fb8d6364-chunk-005</data>
  <data key="d4">Deposit Policy.pdf</data>
  <data key="d5">1786700916</data>
  <data key="d6"></data>
</node>
<node id="Term Deposits">
  <data key="d0">Term Deposits</data>
  <data key="d1">other</data>
  <data key="d2">Fixed-term deposit accounts that earn interest based on specified terms set by the Bank, influenced by guidelines from the Reserve Bank of India.</data>
  <data key="d3">doc-6e9c97657e05cf315dfdf575fb8d6364-chunk-005</data>
  <data key="d4">Deposit Policy.pdf</data>
  <data key="d5">1786700916</data>
  <data key="d6"></data>
</node>
<node id="RBI Directives">
  <data key="d0">RBI Directives</data>
  <data key="d1">concept</data>
  <data key="d2">Regulatory guidelines issued by the Reserve Bank of India that govern the calculation of interest on term deposits.</data>
  <data key="d3">doc-6e9c97657e05cf315dfdf575fb8d6364-chunk-005</data>
  <data key="d4">Deposit Policy.pdf</data>
  <data key="d5">1786700916</data>
  <data key="d6"></data>
</node>
<node id="Term Deposit">
  <data key="d0">Term Deposit</data>
  <data key="d1">financialproduct</data>
  <data key="d2">A type of deposit account with a fixed term during which the deposited money earns a specified interest rate.</data>
  <data key="d3">doc-6e9c97657e05cf315dfdf575fb8d6364-chunk-006</data>
  <data key="d4">Deposit Policy.pdf</data>
  <data key="d5">1786700916</data>
  <data key="d6"></data>
</node>
<node id="Deceased Account">
  <data key="d0">Deceased Account</data>
  <data key="d1">concept</data>
  <data key="d2">An account that belongs to a depositor who has passed away, leading to specific policies regarding the handling of funds and interest on the account.</data>
  <data key="d3">doc-6e9c97657e05cf315dfdf575fb8d6364-chunk-006</data>
  <data key="d4">Deposit Policy.pdf</data>
  <data key="d5">1786700916</data>
  <data key="d6"></data>
</node>
<node id="Master Policy on Customer Service">
  <data key="d0">Master Policy on Customer Service</data>
  <data key="d1">content</data>
  <data key="d2">A document outlining the provisions and guidelines related to customer service practices, including the management of term deposits.&lt;SEP&gt;A document that outlines the policies and procedures related to customer service and grievance redressal for the bank.</data>
  <data key="d3">doc-6e9c97657e05cf315dfdf575fb8d6364-chunk-006&lt;SEP&gt;doc-6e9c97657e05cf315dfdf575fb8d6364-chunk-008</data>
  <data key="d4">Deposit Policy.pdf</data>
  <data key="d5">1786700916</data>
  <data key="d6"></data>
</node>
<node id="Nominee">
  <data key="d0">Nominee</data>
  <data key="d1">person</data>
  <data key="d2">An individual designated to receive the benefits of a deceased depositor’s account based on the account holder’s wishes.</data>
  <data key="d3">doc-6e9c97657e05cf315dfdf575fb8d6364-chunk-006</data>
  <data key="d4">Deposit Policy.pdf</data>
  <data key="d5">1786700916</data>
  <data key="d6"></data>
</node>
<node id="Legal Heirs">
  <data key="d0">Legal Heirs</data>
  <data key="d1">person</data>
  <data key="d2">Individuals who are entitled to inherit the assets of a deceased person, including rights to claims on term deposits.</data>
  <data key="d3">doc-6e9c97657e05cf315dfdf575fb8d6364-chunk-006</data>
  <data key="d4">Deposit Policy.pdf</data>
  <data key="d5">1786700916</data>
  <data key="d6"></data>
</node>
<node id="Form 15G">
  <data key="d0">Form 15G</data>
  <data key="d1">artifact</data>
  <data key="d2">A declaration form used by taxpayers in certain conditions to ensure that no tax is deducted at source on the interest income.</data>
  <data key="d3">doc-6e9c97657e05cf315dfdf575fb8d6364-chunk-006</data>
  <data key="d4">Deposit Policy.pdf</data>
  <data key="d5">1786700916</data>
  <data key="d6"></data>
</node>
<node id="Form 15H">
  <data key="d0">Form 15H</data>
  <data key="d1">artifact</data>
  <data key="d2">A declaration form used by senior citizens to request exemption from tax deduction at source on interest income.</data>
  <data key="d3">doc-6e9c97657e05cf315dfdf575fb8d6364-chunk-006</data>
  <data key="d4">Deposit Policy.pdf</data>
  <data key="d5">1786700916</data>
  <data key="d6"></data>
</node>
<node id="Form 16A">
  <data key="d0">Form 16A</data>
  <data key="d1">artifact</data>
  <data key="d2">A tax deduction certificate issued by the bank for the amount of tax deducted at source on term deposit interest.</data>
  <data key="d3">doc-6e9c97657e05cf315dfdf575fb8d6364-chunk-006</data>
  <data key="d4">Deposit Policy.pdf</data>
  <data key="d5">1786700916</data>
  <data key="d6"></data>
</node>
<node id="NRE/NRO Deposit Scheme">
  <data key="d0">NRE/NRO Deposit Scheme</data>
  <data key="d1">concept</data>
  <data key="d2">A scheme for Non-Resident Indians (NRIs) that allows them to deposit money in either Non-Resident (External) Rupee (NRE) or Non-Resident Ordinary (NRO) accounts.</data>
  <data key="d3">doc-6e9c97657e05cf315dfdf575fb8d6364-chunk-006</data>
  <data key="d4">Deposit Policy.pdf</data>
  <data key="d5">1786700916</data>
  <data key="d6"></data>
</node>
<node id="Interest Rate">
  <data key="d0">Interest Rate</data>
  <data key="d1">concept</data>
  <data key="d2">The percentage at which interest is calculated on a deposit account, varying based on specific terms and conditions.</data>
  <data key="d3">doc-6e9c97657e05cf315dfdf575fb8d6364-chunk-006</data>
  <data key="d4">Deposit Policy.pdf</data>
  <data key="d5">1786700916</data>
  <data key="d6"></data>
</node>
<node id="NRE Deposits">
  <data key="d0">NRE Deposits</data>
  <data key="d1">concept</data>
  <data key="d2">NRE Deposits refer to Non-Resident External accounts that allow non-resident Indians to deposit income earned abroad in Indian banks. They are subject to specific interest rates and regulations.</data>
  <data key="d3">doc-6e9c97657e05cf315dfdf575fb8d6364-chunk-007</data>
  <data key="d4">Deposit Policy.pdf</data>
  <data key="d5">1786700916</data>
  <data key="d6"></data>
</node>
<node id="NRO Deposits">
  <data key="d0">NRO Deposits</data>
  <data key="d1">concept</data>
  <data key="d2">NRO Deposits refer to Non-Resident Ordinary accounts that facilitate income earned in India by non-resident Indians. These deposits are available in Indian rupees and are subject to taxation.</data>
  <data key="d3">doc-6e9c97657e05cf315dfdf575fb8d6364-chunk-007</data>
  <data key="d4">Deposit Policy.pdf</data>
  <data key="d5">1786700916</data>
  <data key="d6"></data>
</node>
<node id="Scheduled Commercial Banks">
  <data key="d0">Scheduled Commercial Banks</data>
  <data key="d1">organization</data>
  <data key="d2">Scheduled Commercial Banks are financial institutions listed in the second schedule of the Reserve Bank of India Act, 1934. They provide banking services and can accept deposits from the public.</data>
  <data key="d3">doc-6e9c97657e05cf315dfdf575fb8d6364-chunk-007</data>
  <data key="d4">Deposit Policy.pdf</data>
  <data key="d5">1786700916</data>
  <data key="d6"></data>
</node>
<node id="Board of Directors">
  <data key="d0">Board of Directors</data>
  <data key="d1">organization</data>
  <data key="d2">The Board of Directors is a group of individuals elected to represent shareholders and oversee the activities and policies of the bank or organization.</data>
  <data key="d3">doc-6e9c97657e05cf315dfdf575fb8d6364-chunk-007</data>
  <data key="d4">Deposit Policy.pdf</data>
  <data key="d5">1786700916</data>
  <data key="d6"></data>
</node>
<node id="Deposit Insurance and Credit Guarantee Corporation of India">
  <data key="d0">Deposit Insurance and Credit Guarantee Corporation of India</data>
  <data key="d1">organization</data>
  <data key="d2">The Deposit Insurance and Credit Guarantee Corporation of India is a body established to provide insurance cover for bank deposits and ensure stability in the financial system.</data>
  <data key="d3">doc-6e9c97657e05cf315dfdf575fb8d6364-chunk-007</data>
  <data key="d4">Deposit Policy.pdf</data>
  <data key="d5">1786700916</data>
  <data key="d6"></data>
</node>
<node id="Deceased Depositor">
  <data key="d0">Deceased Depositor</data>
  <data key="d1">concept</data>
  <data key="d2">A deceased depositor is an individual who held a bank account and has passed away, impacting the management of the account and its associated assets.</data>
  <data key="d3">doc-6e9c97657e05cf315dfdf575fb8d6364-chunk-007</data>
  <data key="d4">Deposit Policy.pdf</data>
  <data key="d5">1786700916</data>
  <data key="d6"></data>
</node>
<node id="Customer Information">
  <data key="d0">Customer Information</data>
  <data key="d1">concept</data>
  <data key="d2">Customer Information refers to the data collected from customers by the bank, which may be used for cross-selling services or products.</data>
  <data key="d3">doc-6e9c97657e05cf315dfdf575fb8d6364-chunk-007</data>
  <data key="d4">Deposit Policy.pdf</data>
  <data key="d5">1786700916</data>
  <data key="d6"></data>
</node>
<node id="Unclaimed Deposits">
  <data key="d0">Unclaimed Deposits</data>
  <data key="d1">concept</data>
  <data key="d2">Unclaimed Deposits refer to bank accounts that have not been operated upon for an extended period, leading to their transfer to the Reserve Bank of India.&lt;SEP&gt;Funds that have not been claimed by the depositor for an extended period, often falling under specific guidelines for reclamation.</data>
  <data key="d3">doc-6e9c97657e05cf315dfdf575fb8d6364-chunk-007&lt;SEP&gt;doc-6e9c97657e05cf315dfdf575fb8d6364-chunk-008</data>
  <data key="d4">Deposit Policy.pdf</data>
  <data key="d5">1786700916</data>
  <data key="d6"></data>
</node>
<node id="KYC Documents">
  <data key="d0">KYC Documents</data>
  <data key="d1">other</data>
  <data key="d2">KYC Documents are 'Know Your Customer' documents that banks require to verify the identity of their clients, ensuring compliance with financial regulations.</data>
  <data key="d3">doc-6e9c97657e05cf315dfdf575fb8d6364-chunk-007</data>
  <data key="d4">Deposit Policy.pdf</data>
  <data key="d5">1786700916</data>
  <data key="d6"></data>
</node>
<node id="Joint Account Holders">
  <data key="d0">Joint Account Holders</data>
  <data key="d1">concept</data>
  <data key="d2">Joint Account Holders are individuals who share an account in a bank, allowing multiple parties to access funds and perform transactions.</data>
  <data key="d3">doc-6e9c97657e05cf315dfdf575fb8d6364-chunk-007</data>
  <data key="d4">Deposit Policy.pdf</data>
  <data key="d5">1786700916</data>
  <data key="d6"></data>
</node>
<node id="Dormant Account">
  <data key="d0">Dormant Account</data>
  <data key="d1">concept</data>
  <data key="d2">A Dormant Account refers to a bank account that has not had any transactions for a period of two years, classified to protect the depositor's interest.</data>
  <data key="d3">doc-6e9c97657e05cf315dfdf575fb8d6364-chunk-007</data>
  <data key="d4">Deposit Policy.pdf</data>
  <data key="d5">1786700916</data>
  <data key="d6"></data>
</node>
<node id="Inoperative Account">
  <data key="d0">Inoperative Account</data>
  <data key="d1">concept</data>
  <data key="d2">An Inoperative Account is a bank account that has not been operated for one year, leading the bank to notify the account holder of its status.&lt;SEP&gt;An account that has not had any activity for a specified period, rendering it inactive and requiring specific procedures for reactivation.</data>
  <data key="d3">doc-6e9c97657e05cf315dfdf575fb8d6364-chunk-007&lt;SEP&gt;doc-6e9c97657e05cf315dfdf575fb8d6364-chunk-008</data>
  <data key="d4">Deposit Policy.pdf</data>
  <data key="d5">1786700916</data>
  <data key="d6"></data>
</node>
<node id="Claimants">
  <data key="d0">Claimants</data>
  <data key="d1">person</data>
  <data key="d2">Claimants are individuals or parties who seek to claim the assets or funds from a deceased depositor's account.</data>
  <data key="d3">doc-6e9c97657e05cf315dfdf575fb8d6364-chunk-007</data>
  <data key="d4">Deposit Policy.pdf</data>
  <data key="d5">1786700916</data>
  <data key="d6"></data>
</node>
<node id="Grievance Redressal Policy">
  <data key="d0">Grievance Redressal Policy</data>
  <data key="d1">concept</data>
  <data key="d2">A framework established by the bank for addressing and resolving customer complaints and grievances.</data>
  <data key="d3">doc-6e9c97657e05cf315dfdf575fb8d6364-chunk-008</data>
  <data key="d4">Deposit Policy.pdf</data>
  <data key="d5">1786700916</data>
  <data key="d6"></data>
</node>
<node id="Banking Ombudsman">
  <data key="d0">Banking Ombudsman</data>
  <data key="d1">person</data>
  <data key="d2">An official appointed to address customer complaints against banks and ensure regulatory compliance.</data>
  <data key="d3">doc-6e9c97657e05cf315dfdf575fb8d6364-chunk-008</data>
  <data key="d4">Deposit Policy.pdf</data>
  <data key="d5">1786700916</data>
  <data key="d6"></data>
</node>
<node id="Electronic Clearing Service">
  <data key="d0">Electronic Clearing Service</data>
  <data key="d1">method</data>
  <data key="d2">A facility provided by the bank for automated and periodic payments from customers' accounts.</data>
  <data key="d3">doc-6e9c97657e05cf315dfdf575fb8d6364-chunk-008</data>
  <data key="d4">Deposit Policy.pdf</data>
  <data key="d5">1786700916</data>
  <data key="d6"></data>
</node>
<node id="Direct Debit">
  <data key="d0">Direct Debit</data>
  <data key="d1">method</data>
  <data key="d2">A payment method that allows the bank to withdraw funds directly from a customer's account to cover recurring payments.</data>
  <data key="d3">doc-6e9c97657e05cf315dfdf575fb8d6364-chunk-008</data>
  <data key="d4">Deposit Policy.pdf</data>
  <data key="d5">1786700916</data>
  <data key="d6"></data>
</node>
<node id="Net Banking">
  <data key="d0">Net Banking</data>
  <data key="d1">method</data>
  <data key="d2">An electronic banking service that allows customers to conduct financial transactions online.</data>
  <data key="d3">doc-6e9c97657e05cf315dfdf575fb8d6364-chunk-008</data>
  <data key="d4">Deposit Policy.pdf</data>
  <data key="d5">1786700916</data>
  <data key="d6"></data>
</node>
<node id="Public Awareness Campaigns">
  <data key="d0">Public Awareness Campaigns</data>
  <data key="d1">event</data>
  <data key="d2">Initiatives conducted by the bank to educate the public about banking processes and financial literacy.</data>
  <data key="d3">doc-6e9c97657e05cf315dfdf575fb8d6364-chunk-008</data>
  <data key="d4">Deposit Policy.pdf</data>
  <data key="d5">1786700916</data>
  <data key="d6"></data>
</node>
<node id="Claim Forms">
  <data key="d0">Claim Forms</data>
  <data key="d1">artifact</data>
  <data key="d2">Documents provided by the bank that customers must complete to claim funds from inoperative accounts or unclaimed deposits.</data>
  <data key="d3">doc-6e9c97657e05cf315dfdf575fb8d6364-chunk-008</data>
  <data key="d4">Deposit Policy.pdf</data>
  <data key="d5">1786700916</data>
  <data key="d6"></data>
</node>
<node id="Account Balance">
  <data key="d0">Account Balance</data>
  <data key="d1">data</data>
  <data key="d2">The total amount of money held in a bank account, which may be claimed by depositors or their nominees.</data>
  <data key="d3">doc-6e9c97657e05cf315dfdf575fb8d6364-chunk-008</data>
  <data key="d4">Deposit Policy.pdf</data>
  <data key="d5">1786700916</data>
  <data key="d6"></data>
