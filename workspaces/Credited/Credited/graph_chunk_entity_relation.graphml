<node id="Bank Policy">
  <data key="d0">Bank Policy</data>
  <data key="d1">concept</data>
  <data key="d2">Regulations and guidelines that govern the operations and changes in banking services, affecting savings limits and customer treatment.</data>
  <data key="d3">doc-574eef8b2a231a2171cb4eadad4c29e5-mm-table-000</data>
