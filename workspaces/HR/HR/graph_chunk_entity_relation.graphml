  <data key="d13"></data>
</edge>
<edge source="A" target="X">
  <data key="d7">1.0</data>
  <data key="d8">Upon A's death, X will be granted access to the locker and allowed to remove its contents.</data>
  <data key="d9">Locker Access,Nominee</data>
