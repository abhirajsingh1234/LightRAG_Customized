<node id="Customer">
  <data key="d0">Customer</data>
  <data key="d1">concept</data>
  <data key="d2">An individual or entity that utilizes banking services provided by the Bank, potentially engaging in activities like account activation, claiming balances, or participating in financial literacy campaigns.&lt;SEP&gt;A resident account holder who maintains either a savings or current account with Unity Bank and is eligible for doorstep banking services.</data>
  <data key="d3">doc-6e9c97657e05cf315dfdf575fb8d6364-chunk-008&lt;SEP&gt;doc-574eef8b2a231a2171cb4eadad4c29e5-chunk-000</data>
