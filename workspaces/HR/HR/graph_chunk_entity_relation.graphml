<edge source="Depositor" target="Nominee">
  <data key="d8">2.0</data>
  <data key="d9">The depositor nominates a minor individual as a nominee to inherit the account balance upon the depositor's death.&lt;SEP&gt;The depositor designates a nominee to receive the term deposit's benefits in case of their death.</data>
  <data key="d10">account management,assigns,designates,nominates</data>
  <data key="d11">doc-6e9c97657e05cf315dfdf575fb8d6364-chunk-004&lt;SEP&gt;doc-6e9c97657e05cf315dfdf575fb8d6364-chunk-006</data>
