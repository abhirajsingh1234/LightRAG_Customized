  <data key="d0">Savings Account</data>
  <data key="d1">other</data>
  <data key="d2">A form of demand deposit with restrictions on the number and amount of withdrawals allowed.&lt;SEP&gt;A deposit account that typically offers interest on the balance, often compared to the interest rate of a term deposit when payouts occur.</data>
  <data key="d3">doc-6e9c97657e05cf315dfdf575fb8d6364-chunk-002&lt;SEP&gt;doc-6e9c97657e05cf315dfdf575fb8d6364-chunk-006</data>
