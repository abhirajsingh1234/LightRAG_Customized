  <data key="d5">1787740931</data>
  <data key="d6"></data>
</node>
<node id="Cash Delivery">
  <data key="d0">Cash Delivery</data>
  <data key="d1">other</data>
  <data key="d2">A banking service that provides the same savings limits as Cash Pickup, allowing individuals and senior citizens/differently abled customers to save up to 20,000 per instance.&lt;SEP&gt;A specific type of service in which cash is delivered to customers from their banking accounts as part of Doorstep Banking services.</data>
  <data key="d3">doc-574eef8b2a231a2171cb4eadad4c29e5-chunk-000&lt;SEP&gt;doc-574eef8b2a231a2171cb4eadad4c29e5-mm-table-000</data>
