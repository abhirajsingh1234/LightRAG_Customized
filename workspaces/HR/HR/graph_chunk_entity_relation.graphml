  <data key="d5">1787741494</data>
  <data key="d6"></data>
</node>
<node id="Court Order Decree">
  <data key="d0">Court Order Decree</data>
  <data key="d1">document</data>
  <data key="d2">A ruling issued by a court that can support the processing of claims without requiring a Bond of Indemnity.</data>
