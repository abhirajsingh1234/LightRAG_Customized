<node id="Cash Pickup">
  <data key="d0">Cash Pickup</data>
  <data key="d1">concept</data>
  <data key="d2">A type of cash service where customers receive cash at their location.&lt;SEP&gt;A service component of doorstep banking where bank staff collect cash from a customer's residence for deposit into their own account.</data>
  <data key="d3">doc-574eef8b2a231a2171cb4eadad4c29e5-chunk-000&lt;SEP&gt;doc-574eef8b2a231a2171cb4eadad4c29e5-mm-table-000</data>
  <data key="d4">Door-Step Banking for Senior Citizens and Differently-Abled.pdf</data>
  <data key="d5">1787125496</data>
  <data key="d6"></data>
</node>
<node id="Cash Delivery">
  <data key="d0">Cash Delivery</data>
  <data key="d1">concept</data>
  <data key="d2">A type of cash service where bank staff deliver cash to customers.&lt;SEP&gt;A service component of doorstep banking where bank staff deliver cash withdrawn from a customer's account directly to their residence.</data>
  <data key="d3">doc-574eef8b2a231a2171cb4eadad4c29e5-chunk-000&lt;SEP&gt;doc-574eef8b2a231a2171cb4eadad4c29e5-mm-table-000</data>
  <data key="d4">Door-Step Banking for Senior Citizens and Differently-Abled.pdf</data>
  <data key="d5">1787125496</data>
  <data key="d6"></data>
</node>
<node id="Demand Draft">
  <data key="d0">Demand Draft</data>
  <data key="d1">content</data>
  <data key="d2">A negotiable instrument issued by a bank to pay a certain amount to the designated recipient, deliverable through doorstep banking.</data>
  <data key="d3">doc-574eef8b2a231a2171cb4eadad4c29e5-chunk-000</data>
  <data key="d4">Door-Step Banking for Senior Citizens and Differently-Abled.pdf</data>
  <data key="d5">1787125496</data>
  <data key="d6"></data>
</node>
<node id="Pay Order">
  <data key="d0">Pay Order</data>
  <data key="d1">content</data>
  <data key="d2">A bank order directing a branch to pay a specific sum of money to the named person, deliverable through doorstep banking services.</data>
