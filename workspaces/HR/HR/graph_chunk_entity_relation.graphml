<node id="Non-callable Deposits">
  <data key="d0">Non-callable Deposits</data>
  <data key="d1">concept</data>
  <data key="d2">Term deposits above Rupees one crore that do not allow premature withdrawal.</data>
  <data key="d3">doc-6e9c97657e05cf315dfdf575fb8d6364-chunk-002</data>
  <data key="d4">Deposit Policy.pdf</data>
  <data key="d5">1787740420</data>
  <data key="d6"></data>
</node>
<node id="Document Verification">
  <data key="d0">Document Verification</data>
  <data key="d1">method</data>
  <data key="d2">The process of verifying documents as part of due diligence when opening a deposit account.</data>
  <data key="d3">doc-6e9c97657e05cf315dfdf575fb8d6364-chunk-002</data>
  <data key="d4">Deposit Policy.pdf</data>
  <data key="d5">1787740420</data>
  <data key="d6"></data>
</node>
<node id="Debit Card">
  <data key="d0">Debit Card</data>
  <data key="d1">artifact</data>
  <data key="d2">A payment card issued by the Bank to customers with Savings or Current Accounts, which can be used for transactions subject to usage fees and usage policies.</data>
  <data key="d3">doc-6e9c97657e05cf315dfdf575fb8d6364-chunk-003</data>
  <data key="d4">Deposit Policy.pdf</data>
  <data key="d5">1787740420</data>
