  <data key="d4">Deposit Policy.pdf</data>
  <data key="d5">1787740420</data>
  <data key="d6"></data>
</node>
<node id="Term Deposits">
  <data key="d0">Term Deposits</data>
  <data key="d1">concept</data>
  <data key="d2">A sub-category of deposit products received by the Bank for a fixed period, including various types of term accounts such as recurring and fixed deposits.</data>
  <data key="d3">doc-6e9c97657e05cf315dfdf575fb8d6364-chunk-002</data>
  <data key="d4">Deposit Policy.pdf</data>
  <data key="d5">1787740420</data>
