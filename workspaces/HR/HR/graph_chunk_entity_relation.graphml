  <data key="d6"></data>
</node>
<node id="ATM Network">
  <data key="d0">ATM Network</data>
  <data key="d1">other</data>
  <data key="d2">A network that provides access to ATMs operated by the Bank as well as other banks, allowing customers to perform cash withdrawals and other banking functions.</data>
  <data key="d3">doc-6e9c97657e05cf315dfdf575fb8d6364-chunk-003</data>
  <data key="d4">Deposit Policy.pdf</data>
  <data key="d5">1787057501</data>
  <data key="d6"></data>
</node>
<node id="NEFT">
  <data key="d0">NEFT</data>
  <data key="d1">method</data>
  <data key="d2">National Electronic Funds Transfer, an electronic payment system that enables customers to transfer money from one bank to another.</data>
  <data key="d3">doc-6e9c97657e05cf315dfdf575fb8d6364-chunk-003</data>
  <data key="d4">Deposit Policy.pdf</data>
  <data key="d5">1787057501</data>
  <data key="d6"></data>
</node>
<node id="RTGS">
  <data key="d0">RTGS</data>
  <data key="d1">method</data>
  <data key="d2">Real-Time Gross Settlement, a system that enables high-value money transfers between banks in real time.</data>
  <data key="d3">doc-6e9c97657e05cf315dfdf575fb8d6364-chunk-003</data>
  <data key="d4">Deposit Policy.pdf</data>
  <data key="d5">1787057501</data>
  <data key="d6"></data>
</node>
<node id="Saving Account">
  <data key="d0">Saving Account</data>
  <data key="d1">other</data>
  <data key="d2">A type of bank account that allows customers to deposit money, earn interest, and withdraw funds without penalties.</data>
  <data key="d3">doc-6e9c97657e05cf315dfdf575fb8d6364-chunk-003</data>
  <data key="d4">Deposit Policy.pdf</data>
  <data key="d5">1787057501</data>
  <data key="d6"></data>
</node>
<node id="Statement of Account">
  <data key="d0">Statement of Account</data>
  <data key="d1">content</data>
  <data key="d2">A document provided by the Bank detailing the transactions and balance of a customer's account, issued monthly.</data>
  <data key="d3">doc-6e9c97657e05cf315dfdf575fb8d6364-chunk-003</data>
  <data key="d4">Deposit Policy.pdf</data>
  <data key="d5">1787057501</data>
  <data key="d6"></data>
</node>
<node id="Passbook">
  <data key="d0">Passbook</data>
  <data key="d1">artifact</data>
  <data key="d2">A physical book issued by the Bank to account holders, recording all transactions and balance updates for their accounts.</data>
  <data key="d3">doc-6e9c97657e05cf315dfdf575fb8d6364-chunk-003</data>
  <data key="d4">Deposit Policy.pdf</data>
  <data key="d5">1787057501</data>
  <data key="d6"></data>
</node>
<node id="Joint Account">
  <data key="d0">Joint Account</data>
  <data key="d1">other</data>
  <data key="d2">A bank account held by more than one individual, allowing them to share access to funds and make mutual transactions.</data>
  <data key="d3">doc-6e9c97657e05cf315dfdf575fb8d6364-chunk-003</data>
  <data key="d4">Deposit Policy.pdf</data>
  <data key="d5">1787057501</data>
  <data key="d6"></data>
</node>
<node id="Power of Attorney">
  <data key="d0">Power of Attorney</data>
  <data key="d1">artifact</data>
  <data key="d2">A legal authorization allowing one person to act on behalf of another in financial transactions, specifically related to banking.</data>
  <data key="d3">doc-6e9c97657e05cf315dfdf575fb8d6364-chunk-003</data>
  <data key="d4">Deposit Policy.pdf</data>
  <data key="d5">1787057501</data>
  <data key="d6"></data>
</node>
<node id="Nomination">
  <data key="d0">Nomination</data>
  <data key="d1">concept</data>
  <data key="d2">A facility that allows account holders to designate a person to receive their account balance after their death.</data>
  <data key="d3">doc-6e9c97657e05cf315dfdf575fb8d6364-chunk-003</data>
  <data key="d4">Deposit Policy.pdf</data>
  <data key="d5">1787057501</data>
  <data key="d6"></data>
</node>
<node id="Accounts Operations">
  <data key="d0">Accounts Operations</data>
  <data key="d1">other</data>
  <data key="d2">A process that involves various types of accounts and how they can be operated, including types such as Savings accounts, minor accounts, and joint accounts.</data>
  <data key="d3">doc-6e9c97657e05cf315dfdf575fb8d6364-chunk-003</data>
  <data key="d4">Deposit Policy.pdf</data>
  <data key="d5">1787057501</data>
  <data key="d6"></data>
</node>
<node id="Accounts of Minors">
  <data key="d0">Accounts of Minors</data>
  <data key="d1">other</data>
  <data key="d2">A specific account type that allows a minor to have a savings bank account or term deposit operated by their guardian.</data>
  <data key="d3">doc-6e9c97657e05cf315dfdf575fb8d6364-chunk-003</data>
  <data key="d4">Deposit Policy.pdf</data>
  <data key="d5">1787057501</data>
  <data key="d6"></data>
</node>
<node id="Joint Account Mandate">
  <data key="d0">Joint Account Mandate</data>
  <data key="d1">concept</data>
  <data key="d2">Rules governing how joint accounts can be operated by multiple account holders, including different forms of mandates such as 'Either or Survivor' or 'Anyone or Survivor(s)'.</data>
  <data key="d3">doc-6e9c97657e05cf315dfdf575fb8d6364-chunk-003</data>
  <data key="d4">Deposit Policy.pdf</data>
  <data key="d5">1787057501</data>
  <data key="d6"></data>
</node>
<node id="Former or Survivor Mandate">
  <data key="d0">Former or Survivor Mandate</data>
  <data key="d1">concept</data>
  <data key="d2">A joint account operation method where one account holder (the former) has the primary control over the account, and the final balance is paid to the former on maturity.</data>
  <data key="d3">doc-6e9c97657e05cf315dfdf575fb8d6364-chunk-003</data>
  <data key="d4">Deposit Policy.pdf</data>
  <data key="d5">1787057501</data>
  <data key="d6"></data>
</node>
<node id="Jointly by All Mandate">
  <data key="d0">Jointly by All Mandate</data>
  <data key="d1">concept</data>
  <data key="d2">A joint account operation method requiring all account holders to act together for account management and access.</data>
  <data key="d3">doc-6e9c97657e05cf315dfdf575fb8d6364-chunk-003</data>
  <data key="d4">Deposit Policy.pdf</data>
  <data key="d5">1787057501</data>
  <data key="d6"></data>
</node>
<node id="Guardian">
  <data key="d0">Guardian</data>
  <data key="d1">person</data>
  <data key="d2">An individual appointed to manage the care and property of a disabled person, responsible for opening bank accounts on their behalf.&lt;SEP&gt;An individual authorized to operate a savings bank account or term deposit on behalf of a minor.</data>
  <data key="d3">doc-6e9c97657e05cf315dfdf575fb8d6364-chunk-003&lt;SEP&gt;doc-6e9c97657e05cf315dfdf575fb8d6364-chunk-004</data>
  <data key="d4">Deposit Policy.pdf</data>
  <data key="d5">1787057501</data>
  <data key="d6"></data>
</node>
<node id="KYC Documents">
  <data key="d0">KYC Documents</data>
  <data key="d1">data</data>
  <data key="d2">Documents required for Know Your Customer (KYC) verification to open a bank account, particularly for minors reaching the age of majority.</data>
  <data key="d3">doc-6e9c97657e05cf315dfdf575fb8d6364-chunk-003</data>
  <data key="d4">Deposit Policy.pdf</data>
  <data key="d5">1787057501</data>
  <data key="d6"></data>
</node>
<node id="Depositor">
  <data key="d0">Depositor</data>
  <data key="d1">person</data>
  <data key="d2">A person who holds a deposit account at the Bank and has the authority to nominate a major appointee to manage the account during the minor nominee's minority.&lt;SEP&gt;The individual who places a term deposit with the bank, whose death may affect the handling of the deposit and associated interest.</data>
  <data key="d3">doc-6e9c97657e05cf315dfdf575fb8d6364-chunk-004&lt;SEP&gt;doc-6e9c97657e05cf315dfdf575fb8d6364-chunk-006</data>
  <data key="d4">Deposit Policy.pdf</data>
  <data key="d5">1787057501</data>
  <data key="d6"></data>
</node>
<node id="Appointee">
  <data key="d0">Appointee</data>
  <data key="d1">person</data>
  <data key="d2">A major individual nominated by the depositor to receive the deposit amount on behalf of the minor nominee.</data>
  <data key="d3">doc-6e9c97657e05cf315dfdf575fb8d6364-chunk-004</data>
  <data key="d4">Deposit Policy.pdf</data>
  <data key="d5">1787057501</data>
  <data key="d6"></data>
</node>
<node id="Nominee">
  <data key="d0">Nominee</data>
  <data key="d1">person</data>
  <data key="d2">A minor individual designated by the depositor to receive the account balance in the event of the depositor's death.&lt;SEP&gt;An individual designated by the depositor to receive the benefits of the term deposit in the event of the depositor's death.</data>
  <data key="d3">doc-6e9c97657e05cf315dfdf575fb8d6364-chunk-004&lt;SEP&gt;doc-6e9c97657e05cf315dfdf575fb8d6364-chunk-006</data>
  <data key="d4">Deposit Policy.pdf</data>
  <data key="d5">1787057501</data>
  <data key="d6"></data>
</node>
<node id="Senior Citizen">
  <data key="d0">Senior Citizen</data>
  <data key="d1">person</data>
  <data key="d2">An individual over the age of 60 years who is eligible for higher interest rates on fixed deposits as provided by the Bank.</data>
  <data key="d3">doc-6e9c97657e05cf315dfdf575fb8d6364-chunk-004</data>
  <data key="d4">Deposit Policy.pdf</data>
  <data key="d5">1787057501</data>
  <data key="d6"></data>
</node>
<node id="Illiterate Person">
  <data key="d0">Illiterate Person</data>
  <data key="d1">person</data>
  <data key="d2">An individual who is unable to read or write, under whom the Bank may open deposit accounts with specific conditions.</data>
  <data key="d3">doc-6e9c97657e05cf315dfdf575fb8d6364-chunk-004</data>
  <data key="d4">Deposit Policy.pdf</data>
  <data key="d5">1787057501</data>
  <data key="d6"></data>
</node>
<node id="Visually Challenged Person">
  <data key="d0">Visually Challenged Person</data>
  <data key="d1">person</data>
  <data key="d2">An individual with visual impairment for whom the Bank provides specialized account management and facilities.</data>
  <data key="d3">doc-6e9c97657e05cf315dfdf575fb8d6364-chunk-004</data>
  <data key="d4">Deposit Policy.pdf</data>
  <data key="d5">1787057501</data>
  <data key="d6"></data>
</node>
<node id="Disabled Person">
  <data key="d0">Disabled Person</data>
  <data key="d1">person</data>
  <data key="d2">Persons covered under the National Trust for the Welfare of Persons with Autism, Cerebral Palsy, Mental Retardation and Multiple Disabilities Act, 1999, eligible for account services managed by a guardian.</data>
  <data key="d3">doc-6e9c97657e05cf315dfdf575fb8d6364-chunk-004</data>
  <data key="d4">Deposit Policy.pdf</data>
  <data key="d5">1787057501</data>
  <data key="d6"></data>
</node>
<node id="Transgender Person">
  <data key="d0">Transgender Person</data>
  <data key="d1">person</data>
  <data key="d2">An individual who identifies as a gender different from their assigned sex at birth, recognized as 'Third Gender' by the Bank for account purposes.</data>
  <data key="d3">doc-6e9c97657e05cf315dfdf575fb8d6364-chunk-004</data>
  <data key="d4">Deposit Policy.pdf</data>
  <data key="d5">1787057501</data>
  <data key="d6"></data>
</node>
<node id="Non-Resident Individual">
  <data key="d0">Non-Resident Individual</data>
  <data key="d1">person</data>
  <data key="d2">An individual living outside their country of residence eligible to open deposit accounts based on regulatory guidelines.</data>
  <data key="d3">doc-6e9c97657e05cf315dfdf575fb8d6364-chunk-004</data>
  <data key="d4">Deposit Policy.pdf</data>
  <data key="d5">1787057501</data>
  <data key="d6"></data>
</node>
<node id="Local Level Committees">
  <data key="d0">Local Level Committees</data>
  <data key="d1">organization</data>
  <data key="d2">Committees established under the National Trust Act to oversee the care of disabled persons and facilitate banking services.</data>
  <data key="d3">doc-6e9c97657e05cf315dfdf575fb8d6364-chunk-004</data>
  <data key="d4">Deposit Policy.pdf</data>
  <data key="d5">1787057501</data>
  <data key="d6"></data>
</node>
<node id="District Courts">
  <data key="d0">District Courts</data>
  <data key="d1">organization</data>
  <data key="d2">Judicial authorities that can appoint guardians for individuals needing assistance for banking purposes under the Mental Health Act, 1987.</data>
  <data key="d3">doc-6e9c97657e05cf315dfdf575fb8d6364-chunk-004</data>
  <data key="d4">Deposit Policy.pdf</data>
  <data key="d5">1787057501</data>
  <data key="d6"></data>
</node>
<node id="Domestic Non-Resident Ordinary Account">
  <data key="d0">Domestic Non-Resident Ordinary Account</data>
  <data key="d1">other</data>
  <data key="d2">Type of bank account for non-resident individuals allowing for deposits and earning interest.</data>
  <data key="d3">doc-6e9c97657e05cf315dfdf575fb8d6364-chunk-005</data>
  <data key="d4">Deposit Policy.pdf</data>
  <data key="d5">1787057501</data>
  <data key="d6"></data>
</node>
<node id="Non-Resident External Account">
  <data key="d0">Non-Resident External Account</data>
  <data key="d1">other</data>
  <data key="d2">Type of bank account for non-resident individuals, primarily for foreign currency deposits.</data>
  <data key="d3">doc-6e9c97657e05cf315dfdf575fb8d6364-chunk-005</data>
  <data key="d4">Deposit Policy.pdf</data>
  <data key="d5">1787057501</data>
  <data key="d6"></data>
</node>
<node id="Domestic Current Account">
  <data key="d0">Domestic Current Account</data>
  <data key="d1">other</data>
  <data key="d2">Type of bank account that does not earn any interest on deposits and is primarily meant for day-to-day transactions.</data>
  <data key="d3">doc-6e9c97657e05cf315dfdf575fb8d6364-chunk-005</data>
  <data key="d4">Deposit Policy.pdf</data>
  <data key="d5">1787057501</data>
  <data key="d6"></data>
</node>
<node id="Domestic Savings Bank Accounts">
  <data key="d0">Domestic Savings Bank Accounts</data>
  <data key="d1">other</data>
  <data key="d2">Type of bank accounts that earn interest on deposits and are typically used for individual savings.</data>
  <data key="d3">doc-6e9c97657e05cf315dfdf575fb8d6364-chunk-005</data>
  <data key="d4">Deposit Policy.pdf</data>
  <data key="d5">1787057501</data>
  <data key="d6"></data>
</node>
<node id="Term Deposits">
  <data key="d0">Term Deposits</data>
  <data key="d1">other</data>
  <data key="d2">Type of deposit account offering a fixed interest rate over a specified term or period.</data>
  <data key="d3">doc-6e9c97657e05cf315dfdf575fb8d6364-chunk-005</data>
  <data key="d4">Deposit Policy.pdf</data>
  <data key="d5">1787057501</data>
  <data key="d6"></data>
</node>
<node id="Bulk Deposits">
  <data key="d0">Bulk Deposits</data>
  <data key="d1">other</data>
  <data key="d2">Large deposit amounts typically exceeding three crore rupees that may attract different interest rates.</data>
  <data key="d3">doc-6e9c97657e05cf315dfdf575fb8d6364-chunk-005</data>
  <data key="d4">Deposit Policy.pdf</data>
  <data key="d5">1787057501</data>
  <data key="d6"></data>
</node>
<node id="Capital Gains Accounts Scheme">
  <data key="d0">Capital Gains Accounts Scheme</data>
  <data key="d1">other</data>
  <data key="d2">A specific scheme under which deposits can be made related to the proceeds of capital gains.</data>
  <data key="d3">doc-6e9c97657e05cf315dfdf575fb8d6364-chunk-005</data>
  <data key="d4">Deposit Policy.pdf</data>
  <data key="d5">1787057501</data>
  <data key="d6"></data>
</node>
<node id="Deposit Interest Rate Card">
  <data key="d0">Deposit Interest Rate Card</data>
  <data key="d1">artifact</data>
  <data key="d2">Document maintained by the Bank that lists the interest rates applicable to various deposit accounts.</data>
  <data key="d3">doc-6e9c97657e05cf315dfdf575fb8d6364-chunk-005</data>
  <data key="d4">Deposit Policy.pdf</data>
  <data key="d5">1787057501</data>
  <data key="d6"></data>
</node>
<node id="Term Deposit">
  <data key="d0">Term Deposit</data>
  <data key="d1">content</data>
  <data key="d2">A type of financial deposit placed with the bank for a fixed period, often bearing a specified interest rate that can be affected by various conditions including the death of the depositor.&lt;SEP&gt;A term deposit is a financial instrument offered by banks where a customer deposits a fixed amount of money for a specific term at a predetermined interest rate.</data>
  <data key="d3">doc-6e9c97657e05cf315dfdf575fb8d6364-chunk-006&lt;SEP&gt;doc-6e9c97657e05cf315dfdf575fb8d6364-chunk-007</data>
  <data key="d4">Deposit Policy.pdf</data>
  <data key="d5">1787057501</data>
  <data key="d6"></data>
</node>
<node id="Maturity Date">
  <data key="d0">Maturity Date</data>
  <data key="d1">concept</data>
  <data key="d2">The date on which a term deposit reaches the end of its agreed term, at which point the depositor is entitled to the principal amount and any interest accrued.</data>
  <data key="d3">doc-6e9c97657e05cf315dfdf575fb8d6364-chunk-006</data>
  <data key="d4">Deposit Policy.pdf</data>
  <data key="d5">1787057501</data>
  <data key="d6"></data>
</node>
<node id="Legal Heirs">
  <data key="d0">Legal Heirs</data>
  <data key="d1">person</data>
  <data key="d2">Individuals entitled to inherit from the deceased depositor, who may have a claim on the term deposit in absence of a nominee.</data>
  <data key="d3">doc-6e9c97657e05cf315dfdf575fb8d6364-chunk-006</data>
  <data key="d4">Deposit Policy.pdf</data>
  <data key="d5">1787057501</data>
  <data key="d6"></data>
</node>
<node id="Income Tax Act">
  <data key="d0">Income Tax Act</data>
  <data key="d1">concept</data>
  <data key="d2">The legal framework that governs taxation on interest earned from deposits, determining when tax must be deducted at source.</data>
  <data key="d3">doc-6e9c97657e05cf315dfdf575fb8d6364-chunk-006</data>
  <data key="d4">Deposit Policy.pdf</data>
  <data key="d5">1787057501</data>
  <data key="d6"></data>
</node>
<node id="Form 15G">
  <data key="d0">Form 15G</data>
  <data key="d1">data</data>
  <data key="d2">A declaration form that can be submitted by depositors to claim exemption from TDS on interest income as prescribed under tax regulations.</data>
  <data key="d3">doc-6e9c97657e05cf315dfdf575fb8d6364-chunk-006</data>
  <data key="d4">Deposit Policy.pdf</data>
  <data key="d5">1787057501</data>
  <data key="d6"></data>
</node>
<node id="Form 15H">
  <data key="d0">Form 15H</data>
  <data key="d1">data</data>
  <data key="d2">Similar to Form 15G, this form is utilized by senior citizens to declare their eligibility for tax exemption on interest earned from deposits.</data>
  <data key="d3">doc-6e9c97657e05cf315dfdf575fb8d6364-chunk-006</data>
  <data key="d4">Deposit Policy.pdf</data>
  <data key="d5">1787057501</data>
  <data key="d6"></data>
</node>
<node id="Term Deposit Account">
  <data key="d0">Term Deposit Account</data>
  <data key="d1">content</data>
  <data key="d2">A specific type of account where a term deposit is held, allowing for the management of funds over a predetermined term.</data>
  <data key="d3">doc-6e9c97657e05cf315dfdf575fb8d6364-chunk-006</data>
  <data key="d4">Deposit Policy.pdf</data>
  <data key="d5">1787057501</data>
  <data key="d6"></data>
</node>
<node id="NRE Deposit">
  <data key="d0">NRE Deposit</data>
  <data key="d1">concept</data>
  <data key="d2">NRE deposits refer to Non-Resident External deposits allowing non-resident Indians to park their income earned abroad in India, denominated in Indian rupees.</data>
  <data key="d3">doc-6e9c97657e05cf315dfdf575fb8d6364-chunk-007</data>
  <data key="d4">Deposit Policy.pdf</data>
  <data key="d5">1787057501</data>
  <data key="d6"></data>
</node>
<node id="NRO Deposit">
  <data key="d0">NRO Deposit</data>
  <data key="d1">concept</data>
  <data key="d2">NRO deposits refer to Non-Resident Ordinary deposits that allow non-resident Indians to manage their income earned in India in Indian rupees.</data>
  <data key="d3">doc-6e9c97657e05cf315dfdf575fb8d6364-chunk-007</data>
  <data key="d4">Deposit Policy.pdf</data>
  <data key="d5">1787057501</data>
  <data key="d6"></data>
</node>
<node id="Scheduled Commercial Banks">
  <data key="d0">Scheduled Commercial Banks</data>
  <data key="d1">organization</data>
  <data key="d2">Scheduled Commercial Banks are banks that are included in the second schedule of the Reserve Bank of India Act, 1934, and they provide a range of banking services.</data>
  <data key="d3">doc-6e9c97657e05cf315dfdf575fb8d6364-chunk-007</data>
  <data key="d4">Deposit Policy.pdf</data>
  <data key="d5">1787057501</data>
  <data key="d6"></data>
</node>
<node id="Deposit Insurance and Credit Guarantee Corporation of India">
  <data key="d0">Deposit Insurance and Credit Guarantee Corporation of India</data>
  <data key="d1">organization</data>
  <data key="d2">The Deposit Insurance and Credit Guarantee Corporation of India (DICGC) is a government entity that provides insurance for bank deposits in India.</data>
  <data key="d3">doc-6e9c97657e05cf315dfdf575fb8d6364-chunk-007</data>
  <data key="d4">Deposit Policy.pdf</data>
  <data key="d5">1787057501</data>
  <data key="d6"></data>
</node>
<node id="Master Policy on Customer Service">
  <data key="d0">Master Policy on Customer Service</data>
  <data key="d1">content</data>
  <data key="d2">A formal document outlining the bank's policies and procedures related to customer service and complaint redressal.&lt;SEP&gt;The Master Policy on Customer Service is a document outlining the protocols and guidelines for ensuring customer service and management of accounts at the bank.</data>
  <data key="d3">doc-6e9c97657e05cf315dfdf575fb8d6364-chunk-007&lt;SEP&gt;doc-6e9c97657e05cf315dfdf575fb8d6364-chunk-008</data>
  <data key="d4">Deposit Policy.pdf</data>
  <data key="d5">1787057501</data>
  <data key="d6"></data>
</node>
<node id="Unclaimed Deposits">
  <data key="d0">Unclaimed Deposits</data>
  <data key="d1">concept</data>
  <data key="d2">Unclaimed deposits are accounts that have not had any activity for ten years and are transferred to the Reserve Bank of India under specific regulations.&lt;SEP&gt;Deposits in bank accounts that have not been claimed by the account holder or their nominee after a certain period.</data>
  <data key="d3">doc-6e9c97657e05cf315dfdf575fb8d6364-chunk-007&lt;SEP&gt;doc-6e9c97657e05cf315dfdf575fb8d6364-chunk-008</data>
  <data key="d4">Deposit Policy.pdf</data>
  <data key="d5">1787057501</data>
  <data key="d6"></data>
</node>
<node id="Customer Information">
  <data key="d0">Customer Information</data>
  <data key="d1">concept</data>
  <data key="d2">Customer Information refers to the data collected from customers that can be used for marketing and service improvement purposes.</data>
  <data key="d3">doc-6e9c97657e05cf315dfdf575fb8d6364-chunk-007</data>
  <data key="d4">Deposit Policy.pdf</data>
  <data key="d5">1787057501</data>
  <data key="d6"></data>
</node>
<node id="Public Awareness Campaigns">
  <data key="d0">Public Awareness Campaigns</data>
  <data key="d1">event</data>
  <data key="d2">Initiatives conducted by the bank to educate the public about banking procedures, including activation of inoperative accounts and claiming unclaimed deposits.</data>
  <data key="d3">doc-6e9c97657e05cf315dfdf575fb8d6364-chunk-008</data>
  <data key="d4">Deposit Policy.pdf</data>
  <data key="d5">1787057501</data>
  <data key="d6"></data>
</node>
