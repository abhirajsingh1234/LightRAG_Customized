<node id="Doorstep Banking">
  <data key="d0">Doorstep Banking</data>
  <data key="d1">concept</data>
  <data key="d2">A banking service model where bank staff visit customers' residences to provide banking services, including cash pickup, delivery, and document submissions.</data>
  <data key="d3">doc-574eef8b2a231a2171cb4eadad4c29e5-chunk-000</data>
  <data key="d4">Door-Step Banking for Senior Citizens and Differently-Abled.pdf</data>
  <data key="d5">1787125496</data>
  <data key="d6"></data>
</node>
<node id="Unity Bank">
  <data key="d0">Unity Bank</data>
  <data key="d1">organization</data>
  <data key="d2">A financial institution offering doorstep banking services as outlined in its master policy, operating across multiple branches.</data>
  <data key="d3">doc-574eef8b2a231a2171cb4eadad4c29e5-chunk-000</data>
  <data key="d4">Door-Step Banking for Senior Citizens and Differently-Abled.pdf</data>
  <data key="d5">1787125496</data>
