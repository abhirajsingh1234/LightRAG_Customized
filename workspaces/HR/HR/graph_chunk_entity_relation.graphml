  <data key="d6"></data>
</node>
<node id="Savings Account">
  <data key="d0">Savings Account</data>
  <data key="d1">artifact</data>
  <data key="d2">A type of bank account that allows customers to save money and earn interest, used as a qualifying account for doorstep banking.</data>
  <data key="d3">doc-574eef8b2a231a2171cb4eadad4c29e5-chunk-000</data>
  <data key="d4">Door-Step Banking for Senior Citizens and Differently-Abled.pdf</data>
  <data key="d5">1787125496</data>
