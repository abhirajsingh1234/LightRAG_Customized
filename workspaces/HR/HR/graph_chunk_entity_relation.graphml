</node>
<node id="Current Account">
  <data key="d0">Current Account</data>
  <data key="d1">artifact</data>
  <data key="d2">A type of bank account typically used by businesses or individuals requiring extensive transactions, also qualifying for doorstep banking.</data>
  <data key="d3">doc-574eef8b2a231a2171cb4eadad4c29e5-chunk-000</data>
