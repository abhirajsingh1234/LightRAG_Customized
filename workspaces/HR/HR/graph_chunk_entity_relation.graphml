<node id="Term Deposit Account">
  <data key="d0">Term Deposit Account</data>
  <data key="d1">concept</data>
  <data key="d2">A savings account that holds a fixed amount of money for a specified term, typically with a higher interest rate.&lt;SEP&gt;A financial product that locks funds for a predetermined period in exchange for a higher interest rate, applicable in claims settlements for deceased persons.</data>
  <data key="d3">doc-2d2b1e01babacd5427ea9228ee35f7f9-chunk-006&lt;SEP&gt;doc-2d2b1e01babacd5427ea9228ee35f7f9-mm-table-001</data>
