</node>
<node id="Inoperative Account">
  <data key="d0">Inoperative Account</data>
  <data key="d1">concept</data>
  <data key="d2">An account that has not had any transactions for a prescribed period, resulting in it becoming inactive and requiring a process for activation by the depositor.</data>
  <data key="d3">doc-6e9c97657e05cf315dfdf575fb8d6364-chunk-008</data>
  <data key="d4">Deposit Policy.pdf</data>
  <data key="d5">1787740420</data>
  <data key="d6"></data>
</node>
<node id="Legal Heir">
  <data key="d0">Legal Heir</data>
  <data key="d1">person</data>
  <data key="d2">An individual entitled to inherit the depositor's assets, including any claims to funds in an account following the depositor's death.&lt;SEP&gt;An individual entitled to inherit the assets and rights of a deceased person as per law.&lt;SEP&gt;An individual entitled by law to inherit a deceased person's estate.&lt;SEP&gt;An individual entitled to inherit the assets of a deceased person, including contents in a safe deposit locker.</data>
  <data key="d3">doc-6e9c97657e05cf315dfdf575fb8d6364-chunk-008&lt;SEP&gt;doc-2d2b1e01babacd5427ea9228ee35f7f9-chunk-001&lt;SEP&gt;doc-2d2b1e01babacd5427ea9228ee35f7f9-chunk-002&lt;SEP&gt;doc-2d2b1e01babacd5427ea9228ee35f7f9-chunk-003</data>
