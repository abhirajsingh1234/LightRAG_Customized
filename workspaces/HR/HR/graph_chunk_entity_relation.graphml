</node>
<node id="Senior Citizens">
  <data key="d0">Senior Citizens</data>
  <data key="d1">person</data>
  <data key="d2">Individuals aged over 60 years who qualify for specific banking services such as Door-Step Banking.&lt;SEP&gt;Individuals who are typically above the age of 60 and may be eligible for additional interest rates on their deposits.</data>
  <data key="d3">doc-574eef8b2a231a2171cb4eadad4c29e5-chunk-000&lt;SEP&gt;doc-6e9c97657e05cf315dfdf575fb8d6364-chunk-005</data>
  <data key="d4">Door-Step Banking for Senior Citizens and Differently-Abled.pdf&lt;SEP&gt;Deposit Policy.pdf</data>
  <data key="d5">1787057501</data>
  <data key="d6"></data>
  <data key="d7">Senior Citizens</data>
</node>
<node id="Differently-Abled">
  <data key="d0">Differently-Abled</data>
  <data key="d1">other</data>
  <data key="d2">Individuals with physical or mental disabilities who may require specialized banking services like Door-Step Banking.</data>
  <data key="d3">doc-574eef8b2a231a2171cb4eadad4c29e5-chunk-000</data>
  <data key="d4">Door-Step Banking for Senior Citizens and Differently-Abled.pdf</data>
  <data key="d5">1787055132</data>
  <data key="d6"></data>
</node>
<node id="Customer">
