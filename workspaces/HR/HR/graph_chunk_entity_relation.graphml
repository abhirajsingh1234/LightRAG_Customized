  <data key="d6"></data>
</node>
<node id="X">
  <data key="d0">X</data>
  <data key="d1">person</data>
  <data key="d2">An individual designated as a nominee for lockers associated with the account holders A and B.&lt;SEP&gt;A nominee who may gain access to the locker contents if specific conditions related to nominators A or B dying are met.</data>
  <data key="d3">doc-2d2b1e01babacd5427ea9228ee35f7f9-chunk-006&lt;SEP&gt;doc-2d2b1e01babacd5427ea9228ee35f7f9-mm-table-005</data>
