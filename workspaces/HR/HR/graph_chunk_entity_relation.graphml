</edge>
<edge source="Depositor" target="Account">
  <data key="d8">1.0</data>
  <data key="d9">A depositor holds ownership of an account and has the right to claim any balances, including those inoperative or unclaimed.</data>
  <data key="d10">claims,ownership</data>
  <data key="d11">doc-6e9c97657e05cf315dfdf575fb8d6364-chunk-008</data>
  <data key="d12">Deposit Policy.pdf</data>
  <data key="d13">1787380002</data>
  <data key="d14"></data>
</edge>
<edge source="Persons with Autism" target="Guardian">
  <data key="d8">1.0</data>
  <data key="d9">The guardian is authorized to open and manage accounts for persons with autism.</data>
  <data key="d10">account management,representation</data>
  <data key="d11">doc-6e9c97657e05cf315dfdf575fb8d6364-chunk-004</data>
  <data key="d12">Deposit Policy.pdf</data>
  <data key="d13">1787380002</data>
  <data key="d14"></data>
</edge>
<edge source="Legal Guardian" target="Guardianship Certificate">
  <data key="d8">1.0</data>
  <data key="d9">The legal guardian must provide a Guardianship Certificate to manage the affairs of a disabled individual.</data>
  <data key="d10">account management,authority</data>
  <data key="d11">doc-6e9c97657e05cf315dfdf575fb8d6364-chunk-004</data>
  <data key="d12">Deposit Policy.pdf</data>
  <data key="d13">1787380002</data>
  <data key="d14"></data>
</edge>
<edge source="Domestic Term Deposits" target="Senior Citizens">
  <data key="d8">1.0</data>
  <data key="d9">Senior Citizens may receive additional interest rates on Domestic Term Deposits as determined by the Bank.</data>
  <data key="d10">additional interest,benefits</data>
  <data key="d11">doc-6e9c97657e05cf315dfdf575fb8d6364-chunk-005</data>
  <data key="d12">Deposit Policy.pdf</data>
  <data key="d13">1787380002</data>
  <data key="d14"></data>
</edge>
<edge source="Interest" target="NRE/NRO Deposit Scheme">
  <data key="d8">1.0</data>
  <data key="d9">Interest rates under the NRE/NRO Deposit Scheme are subject to conditions laid out in the governing directions.</data>
  <data key="d10">Subject,Varies</data>
  <data key="d11">doc-6e9c97657e05cf315dfdf575fb8d6364-chunk-006</data>
  <data key="d12">Deposit Policy.pdf</data>
  <data key="d13">1787380002</data>
  <data key="d14"></data>
</edge>
<edge source="NRE Deposits" target="Scheduled Commercial Banks">
  <data key="d8">1.0</data>
  <data key="d9">Scheduled Commercial Banks offer NRE deposits to non-resident Indians for investment in India.</data>
  <data key="d10">banking,offering</data>
  <data key="d11">doc-6e9c97657e05cf315dfdf575fb8d6364-chunk-007</data>
  <data key="d12">Deposit Policy.pdf</data>
  <data key="d13">1787380002</data>
  <data key="d14"></data>
</edge>
<edge source="NRE Deposits" target="Board of Directors">
  <data key="d8">1.0</data>
