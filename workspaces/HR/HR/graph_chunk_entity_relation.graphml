<node id="Minimum Average Balance Requirements">
  <data key="d0">Minimum Average Balance Requirements</data>
  <data key="d1">concept</data>
  <data key="d2">Requirements that stipulate minimum or average balances to be maintained for certain deposit products like Savings Accounts and Current Accounts.</data>
  <data key="d3">doc-6e9c97657e05cf315dfdf575fb8d6364-chunk-002</data>
