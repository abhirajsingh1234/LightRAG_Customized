<node id="Cash Pickup">
  <data key="d0">Cash Pickup</data>
  <data key="d1">other</data>
  <data key="d2">A banking service that allows customers to save up to 20,000 for individuals and senior citizens/differently abled customers per instance.&lt;SEP&gt;A specific type of service provided under Doorstep Banking, allowing customers to have cash collected from their location for deposit into their accounts.</data>
  <data key="d3">doc-574eef8b2a231a2171cb4eadad4c29e5-chunk-000&lt;SEP&gt;doc-574eef8b2a231a2171cb4eadad4c29e5-mm-table-000</data>
