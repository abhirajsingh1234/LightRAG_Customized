  <data key="d7">Reserve Bank of India</data>
</node>
<node id="Door-Step Banking">
  <data key="d0">Door-Step Banking</data>
  <data key="d1">concept</data>
  <data key="d2">A banking service that includes cash pickup and delivery, instrument collection, and KYC document submission, specifically designed for senior citizens and differently-abled individuals.</data>
  <data key="d3">doc-574eef8b2a231a2171cb4eadad4c29e5-chunk-000</data>
  <data key="d4">Door-Step Banking for Senior Citizens and Differently-Abled.pdf</data>
  <data key="d5">1787055132</data>
  <data key="d6"></data>
</node>
<node id="Unity Bank">
  <data key="d0">Unity Bank</data>
  <data key="d1">organization</data>
  <data key="d2">A bank that offers various banking services, including Door-Step Banking services for its customers.</data>
  <data key="d3">doc-574eef8b2a231a2171cb4eadad4c29e5-chunk-000</data>
  <data key="d4">Door-Step Banking for Senior Citizens and Differently-Abled.pdf</data>
  <data key="d5">1787055132</data>
