    ],
    [
        {
            "type": "title",
            "content": {
                "title_content": [
                    {
                        "type": "text",
                        "content": "Service Charges"
                    }
                ],
                "level": 2
            },
            "bbox": [
                133,
                109,
                269,
                126
            ]
        },
        {
            "type": "paragraph",
            "content": {
                "paragraph_content": [
                    {
                        "type": "text",
                        "content": "Service charges for door step banking if any will be levied on customers account basis a preagreed schedule of charges communicated through an official communication / brochures / schedule of charges / web site etc."
                    }
                ]
            },
            "bbox": [
                161,
                137,
                872,
                186
            ]
        },
        {
            "type": "paragraph",
            "content": {
                "paragraph_content": [
                    {
                        "type": "text",
                        "content": "The Bank may decide to charge the customer differentially basis the cost it incurs in delivering such services or by different variant of account or by size of the relationship with the bank."
                    }
                ]
            },
            "bbox": [
                161,
                188,
                872,
                237
            ]
        },
        {
            "type": "paragraph",
            "content": {
                "paragraph_content": [
                    {
                        "type": "text",
                        "content": "Any change in the service charges will be intimated to customers through any of the modes o Websites"
                    }
                ]
            },
            "bbox": [
                161,
                238,
                870,
                270
            ]
        },
        {
            "type": "paragraph",
            "content": {
                "paragraph_content": [
                    {
                        "type": "text",
                        "content": "o Mobile banking alerts"
                    }
                ]
            },
            "bbox": [
                218,
                271,
                415,
                287
            ]
        },
        {
            "type": "paragraph",
            "content": {
                "paragraph_content": [
                    {
                        "type": "text",
                        "content": "o Notice Boards"
                    }
                ]
            },
            "bbox": [
                218,
                287,
                359,
                303
            ]
        },
        {
            "type": "paragraph",
            "content": {
                "paragraph_content": [
                    {
                        "type": "text",
                        "content": "o SMS / email to registered email id or registered mobile numbers"
                    }
                ]
            },
            "bbox": [
                217,
                304,
                728,
                320
            ]
        },
        {
            "type": "paragraph",
            "content": {
                "paragraph_content": [
                    {
                        "type": "text",
                        "content": "The Bank shall inform at least 1 month in advance of any change to the schedule of charges on account of door step banking services."
                    }
                ]
            },
            "bbox": [
                163,
                321,
                872,
                354
            ]
        },
        {
            "type": "title",
            "content": {
                "title_content": [
                    {
                        "type": "text",
                        "content": "Force Majeure"
                    }
                ],
                "level": 2
            },
            "bbox": [
                107,
                377,
                232,
                395
            ]
        },
        {
            "type": "paragraph",
            "content": {
                "paragraph_content": [
                    {
                        "type": "text",
                        "content": "The Bank shall not be liable to compensate customers for delayed credit or delayed delivery / nondelivery of services for reasons beyond the control of the Bank [including but not limited to civil commotion, sabotage, lockout, strike or other labour disturbances, accident, fires, natural disasters or other “Acts of God\", war, damage to the bank's facilities or of its correspondent bank(s), absence of the usual means of communication or all types of transportation, etc.] that prevent the bank from performing its obligations within specified service delivery parameters."
                    }
                ]
            },
            "bbox": [
                104,
                406,
                874,
                507
            ]
        },
        {
