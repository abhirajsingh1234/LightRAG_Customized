        },
        {
            "type": "title",
            "content": {
                "title_content": [
                    {
                        "type": "text",
                        "content": "Door-Step Banking for Senior Citizens and Differently-Abled"
                    }
                ],
                "level": 1
            },
            "bbox": [
                245,
                117,
                733,
                135
            ]
        },
        {
            "type": "title",
            "content": {
                "title_content": [
                    {
                        "type": "text",
                        "content": "Introduction"
                    }
                ],
                "level": 2
            },
            "bbox": [
                133,
                154,
                243,
                171
            ]
        },
        {
            "type": "paragraph",
            "content": {
                "paragraph_content": [
                    {
                        "type": "text",
                        "content": "Reserve Bank of India advised Banks to have a scheme for providing services on the doorstep of its customers with the approval of the Board. This document enumerates a comprehensive policy setting up a framework within which the Doorstep Banking services would be provided to the customer."
                    }
                ]
            },
            "bbox": [
                132,
                176,
                874,
                244
            ]
        },
        {
            "type": "paragraph",
            "content": {
                "paragraph_content": [
                    {
                        "type": "text",
                        "content": "RBI guidelines on Doorstep Banking were issued in 1993, 2005, 2007 and 2017. This policy documents takes references from these circulars as a guided reference."
                    }
                ]
            },
            "bbox": [
                133,
                253,
                872,
                289
            ]
        },
        {
            "type": "title",
            "content": {
                "title_content": [
                    {
                        "type": "text",
                        "content": "Definition"
                    }
                ],
                "level": 2
            },
            "bbox": [
                133,
                299,
                220,
                316
            ]
        },
        {
            "type": "paragraph",
            "content": {
                "paragraph_content": [
                    {
                        "type": "text",
                        "content": "The term “Door Step Banking\" shall include the following services:"
                    }
                ]
            },
            "bbox": [
                133,
                332,
                643,
                349
            ]
        },
        {
            "type": "paragraph",
            "content": {
                "paragraph_content": [
                    {
                        "type": "text",
                        "content": "Pick up of cash for deposit into own accounts."
                    }
                ]
            },
            "bbox": [
                161,
                366,
                537,
                383
            ]
        },
        {
            "type": "paragraph",
            "content": {
                "paragraph_content": [
                    {
                        "type": "text",
                        "content": "Pick up of instrument (cheques / Remittance forms) for credit to own account."
                    }
                ]
            },
            "bbox": [
                161,
                383,
                772,
                400
            ]
        },
        {
            "type": "paragraph",
            "content": {
                "paragraph_content": [
                    {
                        "type": "text",
                        "content": "Delivery of cash by withdrawal from own accounts."
                    }
                ]
            },
            "bbox": [
                161,
                402,
                581,
                417
            ]
        },
        {
            "type": "paragraph",
            "content": {
                "paragraph_content": [
                    {
                        "type": "text",
                        "content": "Delivery of Demand draft and pay order issued by debit to own account."
                    }
                ]
            },
            "bbox": [
                161,
                419,
                730,
                435
            ]
        },
        {
            "type": "paragraph",
            "content": {
                "paragraph_content": [
                    {
                        "type": "text",
                        "content": "Submission of KYC document by Senior citizen (Citizens aged over 60 years) and differently-abled"
                    }
                ]
            },
            "bbox": [
                161,
                436,
                872,
                469
            ]
        },
        {
            "type": "paragraph",
            "content": {
                "paragraph_content": [
                    {
                        "type": "text",
                        "content": "Any other service which RBI guides from time to time."
                    }
                ]
            },
            "bbox": [
                161,
                470,
                604,
                487
            ]
        },
        {
            "type": "title",
            "content": {
                "title_content": [
                    {
                        "type": "text",
                        "content": "Customer"
                    }
                ],
                "level": 2
            },
            "bbox": [
                133,
                494,
                220,
                510
            ]
        },
        {
            "type": "paragraph",
            "content": {
                "paragraph_content": [
                    {
                        "type": "text",
                        "content": "The term customer will be defined as a resident account holder maintains a savings or a current account with Unity Bank."
                    }
                ]
            },
            "bbox": [
                133,
                521,
                872,
                555
            ]
        },
        {
            "type": "paragraph",
            "content": {
                "paragraph_content": [
                    {
                        "type": "text",
                        "content": "The door step banking service will be offered only on working days of a branch to those customers who satisfy the following conditions. The list of branches where the services are offered shall be displayed on the website of the Bank."
                    }
                ]
            },
            "bbox": [
                135,
                566,
                872,
                617
            ]
        },
        {
            "type": "paragraph",
            "content": {
                "paragraph_content": [
                    {
                        "type": "text",
                        "content": "Single account holders and Joint Account Holders with Either or Survivor/ Former or Survivor"
                    }
                ]
            },
            "bbox": [
                161,
                628,
                872,
                660
            ]
        },
        {
            "type": "paragraph",
            "content": {
                "paragraph_content": [
                    {
                        "type": "text",
                        "content": "All the KYC document in procession of the bank are in current and there are no deferrals pending on account of documentation"
                    }
                ]
            },
            "bbox": [
                161,
                662,
                870,
                696
            ]
        },
        {
            "type": "paragraph",
            "content": {
                "paragraph_content": [
                    {
                        "type": "text",
                        "content": "The account is operative in nature"
                    }
                ]
            },
            "bbox": [
                163,
                696,
                449,
                712
            ]
        },
        {
            "type": "paragraph",
            "content": {
                "paragraph_content": [
                    {
                        "type": "text",
                        "content": "Inoperative account holders can activate the door step banking after activating the account post submission of the necessary documents."
                    }
                ]
            },
            "bbox": [
                161,
                714,
                872,
                747
            ]
        },
        {
            "type": "paragraph",
            "content": {
                "paragraph_content": [
                    {
                        "type": "text",
                        "content": "All relevant application / forms are signed by the customer for availing such facility."
                    }
                ]
            },
            "bbox": [
                161,
                747,
                820,
                765
            ]
        },
        {
            "type": "page_footer",
            "content": {
                "page_footer_content": [
                    {
                        "type": "text",
                        "content": "INTERNAL"
                    }
                ]
            },
            "bbox": [
                457,
                968,
                540,
                984
            ]
        },
        {
            "type": "page_footer",
            "content": {
                "page_footer_content": [
                    {
                        "type": "text",
                        "content": "Version 4.0 Master Policy on Customer Service"
                    }
                ]
            },
            "bbox": [
                107,
                912,
                354,
                943
